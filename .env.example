NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ================================================
# Supabase — Project configuration
# Lấy từ: Supabase Dashboard > Settings > API
# ================================================

# Auth (Public — safe to expose in browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ================================================
# Prisma — Supabase PostgreSQL Connection
# Lấy từ: Supabase Dashboard > Settings > Database > Connection string
# ================================================

# Dùng cho Prisma Client (app runtime) — Transaction Mode via Pooler (port 6543)
DATABASE_URL=

# Dùng cho Prisma Migrate (DDL) — Session Mode via Pooler (port 5432) cho IPv4
DIRECT_URL=

# Service role key (KHÔNG BAO GIỜ expose ra client)
SUPABASE_SERVICE_ROLE_KEY=

# ================================================
# SMTP (Gmail App Password)
# Lấy từ: https://myaccount.google.com/apppasswords
# ================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ================================================
# Cloudinary
# Lấy từ: Cloudinary Dashboard > Settings > Security
# ================================================
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
NEXT_PUBLIC_CLOUDINARY_API_KEY=
NEXT_PUBLIC_CLOUDINARY_API_SECRET=
